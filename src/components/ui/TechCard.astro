---
const { name, icon: Icon } = Astro.props;
---

<li class="tech-card">
    <Icon class="tech-icon" />
    <p>{name}</p>
</li>

<style>
    .tech-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 1rem 1.5rem;
        font-weight: bold;
        background-color: var(--bg-secondary);
        border: 1px solid var(--border-color);
        border-radius: 20px;
        gap: 0.5rem;
        transition: all 0.3s ease-in;
    }

    .tech-card:hover {
        transform: scale(1.05);
        border-color: var(--color-electric-violet-700);
        color: var(--color-electric-violet-700);
    }

    .tech-icon {
        width: 90px;
        height: 90px;
    }
</style>
