---
interface Props {
    title: string;
    type: string;
    institution: string;
    year: string;
    description: string;
    skills: string[];
}

const { title, type, institution, year, description, skills } = Astro.props;
---

<li class="education-card">
    <h3 class="dm-serif">{title}</h3>
    <span class="education-meta">
        {type} - {institution} - {year}
    </span>
    <p class="description">{description}</p>
    <ul class="skills-list">
        {skills.map((skill) => (
            <li class="skill-tag">{skill}</li>
        ))}
    </ul>
</li>

<style>
    .education-card {
        display: flex;
        flex-direction: column;
        padding: 1rem;
        border-radius: 1rem;
        background-color: var(--bg-secondary);
        border: 1px solid var(--border-color);
        transition: all 0.3s ease-in;
    }

    .education-card:hover {
        border-color: var(--color-electric-violet-700);
    }

    .education-card h3 {
        font-size: 1.3rem;
        margin-bottom: 0.2rem;
        letter-spacing: 1px;
    }

    .education-meta {
        font-weight: 600;
        color: var(--color-electric-violet-800);
        margin-bottom: 0.5rem;
    }

    .description {
        margin-bottom: 1rem;
        line-height: 1.5;
    }

    .skills-list {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .skill-tag {
        font-weight: 600;
        padding: 0.7rem;
        border-radius: 1rem;
        border: 1px solid var(--border-bottom);
        background-color: var(--bg-tertiary);
    }

    /* ===== TABLET ===== */
    @media (min-width: 768px) {
        .education-card {
            width: 48%;
        }
    }
</style>
