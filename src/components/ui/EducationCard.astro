---
interface Props {
    title: string;
    type: string;
    institution: string;
    year: string;
    description: string;
    skills: string[];
}

const { title, type, institution, year, description, skills } = Astro.props;
---

<li class="education-card">
    <h3>{title}</h3>
    <span class="education-meta">{type} — {institution} — {year}</span>
    <p class="description">{description}</p>
    <ul class="skills-list">
        {skills.map((skill) => <li class="skill-tag">{skill}</li>)}
    </ul>
</li>
