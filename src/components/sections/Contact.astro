---
import ContactItem from "@/components/ui/ContactItem.astro";
import emailIcon from "@/components/icons/Email.astro";
import githubIcon from "@/components/icons/Github.astro";
import youtubeIcon from "@/components/icons/Youtube.astro";
import linkedinIcon from "@/components/icons/Linkedin.astro";
import twitterIcon from "@/components/icons/Twitter.astro";
import tiktokIcon from "@/components/icons/Tiktok.astro";
import instagramIcon from "@/components/icons/Instagram.astro";
import facebookIcon from "@/components/icons/Facebook.astro";
import { Image } from "astro:assets";
import profileImage from "@/assets/profile.webp";

const CONTACT_CHANNELS = [
    {
        title: "Email",
        value: "kmarrufo62@gmail.com",
        icon: emailIcon,
    },
    {
        title: "Github",
        value: "@kevdhev1",
        href: "#",
        icon: githubIcon,
    },
    {
        title: "Linkedin",
        value: "@kevdhev",
        href: "#",
        icon: linkedinIcon,
    },
    {
        title: "Youtube",
        value: "@kevdhev",
        href: "#",
        icon: youtubeIcon,
    },
    {
        title: "TikTok",
        value: "@kevdhev",
        href: "#",
        icon: tiktokIcon,
    },
    {
        title: "Twitter",
        value: "@kevdhev1",
        href: "#",
        icon: twitterIcon,
    },
    {
        title: "Instagram",
        value: "@kevdhev",
        href: "#",
        icon: instagramIcon,
    },
    {
        title: "Facebook",
        value: "@kevdhev",
        href: "#",
        icon: facebookIcon,
    },
];
---

<section id="contact" class="contact">
    <p class="indicator">TRABAJEMOS JUNTOS</p>
    <h2 class="dm-serif">Contacto</h2>
    <p class="description">
        ¿Tienes alguna propuesta o simplemente quieres conectar? Puedes
        contactarme directamente por correo o encontrarme en mis principales
        redes.
    </p>
    <div class="social-container">
        <ul class="contact-list">
            {CONTACT_CHANNELS.map((channel) => (
                <ContactItem {...channel} />
            ))}
        </ul>
        <div class="image-wrapper">
            <Image
                src={profileImage}
                alt="Foto de perfil"
                class="profile-image"
            />
        </div>
    </div>
</section>

<style>
    .contact {
        width: 350px;
        padding: 3rem 1rem;
        margin: 1.5rem auto;
        border-bottom: var(--border-bottom);
    }

    .contact h2 {
        font-size: 1.8rem;
        margin-bottom: 0.5rem;
    }

    .description {
        font-size: 1.02rem;
        line-height: 1.5;
        margin-bottom: 1.5rem;
    }

    .social-container {
        display: flex;
        flex-direction: column-reverse;
        justify-content: center;
        align-items: center;
        gap: 2rem;
    }

    .contact-list {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        width: 100%;
        gap: 1rem;
    }

    .profile-image {
        width: 280px;
        height: auto;
        border-radius: 1rem;
    }
</style>
