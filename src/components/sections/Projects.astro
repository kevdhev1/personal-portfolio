---
import ProjectCard from "@/components/ui/ProjectCard.astro";
import example from "@/assets/example.webp";

const PROJECTS = [
    {
        title: "EJEMPLO DE PROYECTO",
        description:
            "Lorem ipsum dolor sit amet consectetur, adipisicing elit. Amet fugit tenetur magnam dolor non dolorum.",
        image: example,
        tags: ["TypeScript", "React", "Python", "FastAPI"],
        link: "#",
        github: "#",
        youtube: "#",
    },
];
---

<section id="projects" class="projects">
    <p class="indicator">MEJORES TRABAJOS</p>
    <h2 class="dm-serif">Proyectos</h2>
    <p class="description">
        Proyectos desarrollados por mi cuenta desde cero hasta su despliegue y
        puesta en producción.
    </p>
    <ul class="projects-list">
        {PROJECTS.map((project) => <ProjectCard {...project} />)}
    </ul>
</section>

<style>
    .projects {
        width: 350px;
        padding: 3rem 1rem;
        margin: 1.5rem auto;
        border-bottom: var(--border-bottom);
    }

    .projects h2 {
        font-size: 1.8rem;
        margin-bottom: 0.5rem;
    }

    .description {
        font-size: 1.08rem;
        line-height: 1.5;
        margin-bottom: 1.5rem;
    }

    .projects-list {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }
</style>
