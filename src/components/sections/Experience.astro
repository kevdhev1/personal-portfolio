---
import ExperienceCard from "@/components/ui/ExperienceCard.astro";

const EXPERIENCE = [
    {
        role: "Desarrollador Frontend",
        company: "Proyecto / Freelance",
        period: "2023 - Presente",
        description:
            "Diseño y desarrollo de interfaces web accesibles y optimizadas, aplicando buenas prácticas de desarrollo componentizado y CSS nativo.",
        technologies: ["Astro", "TypeScript", "CSS", "Git"],
    },
    {
        role: "Desarrollador Software",
        company: "Empresa o Cliente",
        period: "2022 - 2023",
        description:
            "Construcción de APIs y lógica de negocio para la automatización de procesos internos y herramientas de software.",
        technologies: ["Python", "FastAPI", "JavaScript", "Linux"],
    },
];
---

<section id="experience">
    <p>¿DÓNDE HE TRABAJADO?</p>
    <h2>Experiencia laboral</h2>
    <p>
        Experiencia y responsabilidades obtenidas en distintos entornos
        profesionales y proyectos reales.
    </p>

    <ul class="experience-list">
        {EXPERIENCE.map((item) => <ExperienceCard {...item} />)}
    </ul>
</section>
