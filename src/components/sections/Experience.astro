---
import ExperienceCard from "@/components/ui/ExperienceCard.astro";

const EXPERIENCE = [
    {
        role: "Desarrollador Frontend",
        company: "Proyecto / Freelance",
        period: "2023 - Presente",
        description:
            "Diseño y desarrollo de interfaces web accesibles y optimizadas, aplicando buenas prácticas de desarrollo componentizado y CSS nativo.",
        technologies: ["Astro", "TypeScript", "CSS", "Git"],
    },
    {
        role: "Desarrollador Software",
        company: "Empresa o Cliente",
        period: "2022 - 2023",
        description:
            "Construcción de APIs y lógica de negocio para la automatización de procesos internos y herramientas de software.",
        technologies: ["Python", "FastAPI", "JavaScript", "Linux"],
    },
];
---

<section id="experience" class="experience">
    <p class="indicator">¿DÓNDE HE TRABAJADO?</p>
    <h2 class="dm-serif">Experiencia</h2>
    <p class="description">
        Trayectoria y responsabilidades obtenidas en distintos entornos
        profesionales y proyectos reales.
    </p>

    <ul class="experience-list">
        {EXPERIENCE.map((item) => (
            <ExperienceCard {...item} />
        ))}
    </ul>
</section>

<style>
    .experience {
        width: 350px;
        padding: 3rem 1rem;
        margin: 1.5rem auto;
        border-bottom: var(--border-bottom);
    }

    .experience h2 {
        font-size: 1.8rem;
        margin-bottom: 0.5rem;
    }

    .description {
        font-size: 1.09rem;
        line-height: 1.5;
        margin-bottom: 1.5rem;
    }

    .experience-list {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1.5rem;
    }

    /* ===== TABLET ===== */
    @media (min-width: 768px) {
        .experience {
            width: 740px;
            padding-top: 5rem;
            padding-bottom: 5rem;
        }

        .experience h2 {
            font-size: 2rem;
        }

        .description {
            max-width: 50ch;
        }
    }

    /* ===== DESKTOP ===== */
    @media (min-width: 1024px) {
        .experience {
            width: 970px;
        }

        .experience h2 {
            font-size: 2.25rem;
        }

        .description {
            font-size: 1.15rem;
            font-weight: 500;
            margin-bottom: 2rem;
        }
    }
</style>
